# =============================================================================
# Parichay Production Environment — EC2 + PostgreSQL + Redis
# Copy to /opt/parichay/.env.production and fill in values
# =============================================================================

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://parichay.io
NEXT_PUBLIC_APP_NAME=Parichay

# --- Database (PostgreSQL in Docker) ---
DATABASE_URL=postgresql://parichay:YOUR_DB_PASSWORD@db:5432/parichay_prod
DB_PASSWORD=YOUR_DB_PASSWORD

# --- Authentication ---
JWT_SECRET=GENERATE_WITH_openssl_rand_base64_32
JWT_REFRESH_SECRET=GENERATE_WITH_openssl_rand_base64_32

# --- Field-Level Encryption ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Redis (Docker internal) ---
REDIS_URL=redis://redis:6379

# --- Razorpay Payments ---
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- AWS S3 (file uploads) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=parichay-uploads

# --- Google Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Error Tracking ---
SENTRY_DSN=

# --- Cron Secret (for scheduled jobs) ---
CRON_SECRET=GENERATE_RANDOM_STRING
